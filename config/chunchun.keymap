#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/rgb.h>

/ {
    behaviors {
        ug_hue: ug_hue {
            compatible = "zmk,behavior-sensor-rotate";
            label = "UG_HUE";
            #sensor-binding-cells = <0>;
            bindings = <&rgb_ug RGB_HUI>, <&rgb_ug RGB_HUD>;
        };

        ug_sat: ug_sat {
            compatible = "zmk,behavior-sensor-rotate";
            label = "UG_SAT";
            #sensor-binding-cells = <0>;
            bindings = <&rgb_ug RGB_SAI>, <&rgb_ug RGB_SAD>;
        };

        ug_bright: ug_bright {
            compatible = "zmk,behavior-sensor-rotate";
            label = "UG_BRIGHT";
            #sensor-binding-cells = <0>;
            bindings = <&rgb_ug RGB_BRI>, <&rgb_ug RGB_BRD>;
        };

        // Hold for layer 2, double tap to lock the fn layer
        raise_fn: raise_fn {
            compatible = "zmk,behavior-tap-dance";
            label = "RAISE_FN";
            #binding-cells = <0>;
            bindings = <&mo 2>, <&tog 3>;
            tapping-term-ms = <200>;
        };

        // Switch output to Bluetooth, then pick the profile; plain BT_SEL stays on USB while plugged in
        bt_sel: bt_sel {
            compatible = "zmk,behavior-macro-one-param";
            label = "BT_SEL";
            #binding-cells = <1>;
            bindings = <&out OUT_BLE>, <&macro_param_1to2>, <&bt BT_SEL MACRO_PLACEHOLDER>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        windows {
            bindings = <
&kp ESC    &kp F1  &kp F2     &kp F3    &kp F4    &kp F5                                  &kp F6     &kp F7    &kp F8     &kp F9     &kp F10   &kp F11
&kp GRAVE  &kp N1  &kp N2     &kp N3    &kp N4    &kp N5                                  &kp N6     &kp N7    &kp N8     &kp N9     &kp N0    &kp BSPC
&kp TAB    &kp Q   &kp W      &kp E     &kp R     &kp T                                   &kp Y      &kp U     &kp I      &kp O      &kp P     &kp BSLH
&kp CAPS   &kp A   &kp S      &kp D     &kp F     &kp G                                   &kp H      &kp J     &kp K      &kp L      &kp SEMI  &kp APOS
&kp LSHFT  &kp Z   &kp X      &kp C     &kp V     &kp B      &kp C_MUTE  &kp PRINTSCREEN  &kp N      &kp M     &kp COMMA  &kp DOT    &kp FSLH  &kp RSHFT
                   &kp LCTRL  &kp LALT  &kp LGUI  &raise_fn  &kp SPACE   &kp ENTER        &raise_fn  &kp RGUI  &kp RALT   &kp RCTRL
            >;

            sensor-bindings =
                <&inc_dec_kp C_VOLUME_UP C_VOLUME_DOWN>,
                <&inc_dec_kp PG_DN PG_UP>;
        };

        macos {
            bindings = <
&trans  &trans  &trans    &trans  &trans     &trans                  &trans  &trans     &trans  &trans    &trans  &trans
&trans  &trans  &trans    &trans  &trans     &trans                  &trans  &trans     &trans  &trans    &trans  &trans
&trans  &trans  &trans    &trans  &trans     &trans                  &trans  &trans     &trans  &trans    &trans  &trans
&trans  &trans  &trans    &trans  &trans     &trans                  &trans  &trans     &trans  &trans    &trans  &trans
&trans  &trans  &trans    &trans  &trans     &trans  &trans  &trans  &trans  &trans     &trans  &trans    &trans  &trans
                &kp LGUI  &trans  &kp LCTRL  &trans  &trans  &trans  &trans  &kp RCTRL  &trans  &kp RGUI
            >;

            sensor-bindings =
                <&inc_dec_kp C_VOLUME_UP C_VOLUME_DOWN>,
                <&inc_dec_kp PG_DN PG_UP>;
        };

        shift {
            bindings = <
&none  &none     &none     &none      &none  &none                &none  &none  &none  &none      &none      &kp F12
&none  &none     &none     &none      &none  &none                &none  &none  &none  &kp MINUS  &kp EQUAL  &kp DEL
&none  &none     &kp UP    &none      &none  &none                &none  &none  &none  &kp LBKT   &kp RBKT   &none
&none  &kp LEFT  &kp DOWN  &kp RIGHT  &none  &none                &none  &none  &none  &none      &none      &none
&none  &none     &none     &none      &none  &none  &none  &none  &none  &none  &none  &none      &none      &none
                 &none     &none      &none  &none  &none  &none  &none  &none  &none  &none
            >;

            sensor-bindings = <&ug_hue>, <&ug_bright>;
        };

        fn {
            bindings = <
&studio_unlock  &bt_sel 0  &bt_sel 1  &bt_sel 2  &bt_sel 3  &bt_sel 4                           &trans  &trans  &trans  &trans  &trans  &trans
&out OUT_USB    &trans     &trans     &trans     &trans     &trans                              &trans  &trans  &trans  &trans  &trans  &bt BT_CLR
&trans          &trans     &trans     &trans     &trans     &trans                              &trans  &trans  &trans  &trans  &trans  &trans
&trans          &trans     &trans     &trans     &trans     &trans                              &trans  &trans  &trans  &trans  &trans  &trans
&trans          &trans     &trans     &trans     &trans     &trans     &rgb_ug RGB_TOG  &trans  &trans  &trans  &trans  &tog 1  &trans  &trans
                           &trans     &trans     &trans     &tog 3     &trans           &trans  &tog 3  &trans  &trans  &trans
            >;
        };
    };
};
